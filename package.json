{
  "name": "jsonfeed-to-atom",
  "description": "Convert a JSON Feed 1.1 document to an Atom feed",
  "version": "1.2.5",
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/bcomnes/jsonfeed-to-atom/issues"
  },
  "dependencies": {
    "striptags": "^3.2.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@voxpelli/tsconfig": "^16.2.1",
    "@types/node": "^20.19.0",
    "json-schema-to-typescript": "^15.0.4",
    "neostandard": "^0.13.0",
    "releasearoni": "^0.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "homepage": "https://github.com/bcomnes/jsonfeed-to-atom",
  "keywords": [
    "atom",
    "json",
    "jsonfeed",
    "rss",
    "xml"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "types.d.ts",
    "types.d.ts.map",
    "object.js",
    "object.d.ts",
    "object.d.ts.map",
    "jsonfeed-to-atom-object.js",
    "jsonfeed-to-atom-object.d.ts",
    "jsonfeed-to-atom-object.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "schemas/**/*",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "type": "module",
  "module": "index.js",
  "main": "index.js",
  "types": "types.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcomnes/jsonfeed-to-atom.git"
  },
  "scripts": {
    "prepublishOnly": "npm run build && releasearoni",
    "postpublish": "npm run clean",
    "test": "npm run test:lint && npm run test:tsc && npm run test:node-test",
    "test:lint": "eslint",
    "test:tsc": "tsc",
    "test:node-test": "node --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info --test",
    "update": "node generate-snapshot.js",
    "version": "releasearoni version",
    "build": "npm run clean && npm run build:schemas && npm run build:declaration",
    "build:schemas": "npm run build:schema:json-feed && npm run build:schema:atom",
    "build:schema:json-feed": "json2ts -i schemas/json-feed-1.1.json -o lib/json-feed-types.d.ts --style.singleQuote --no-style.semi",
    "build:schema:atom": "json2ts -i schemas/atom-feed.json -o lib/atom-feed-types.d.ts --style.singleQuote --no-style.semi",
    "build:declaration": "tsc -p declaration.tsconfig.json",
    "clean": "npm run clean:declarations-top && npm run clean:declarations-lib",
    "clean:declarations-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.d.ts*')",
    "clean:declarations-lib": "rm -rf $(find lib -type f -name '*.d.ts*' ! -name '*-types.d.ts')"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  }
}
